opam-version: "2.0"
synopsis: "Command-line tool for exact currency conversion and fees"
description:
  "The money command converts an amount at an exact price, computes a fee schedule (fixed part, basis points, minimum and maximum, rounded by side) and lists the registered currencies. Built on the money library."
maintainer: ["hello@winterchill.xyz"]
authors: ["WinterChill AI"]
license: "MIT"
tags: ["money" "currency" "cli" "oxcaml"]
homepage: "https://github.com/winterchill-trading/money"
doc: "https://github.com/winterchill-trading/money#readme"
bug-reports: "https://github.com/winterchill-trading/money/issues"
depends: [
  "ocaml-variants" {>= "5.2.0+ox" & < "5.2.1~"}
  "dune" {>= "3.17"}
  "money" {= version}
  "core" {>= "v0.18~preview"}
  "core_unix" {>= "v0.18~preview"}
  "ppx_jane" {>= "v0.18~preview"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/winterchill-trading/money.git"
